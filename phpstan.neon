parameters:
    level: 5
    paths:
        - api
        - scripts
    scanFiles:
        - api/bootstrap.php
    bootstrapFiles:
        - api/config.example.php
    dynamicConstantNames:
        - APP_ENV
        # Renseignée seulement si un CDN/reverse-proxy est placé devant le site
        # (vide dans config.example.php) — cf. api/lib/client_ip.php.
        - TRUSTED_PROXIES
        - DB_HOST
        - DB_PORT
        - DB_NAME
        - DB_USER
        - DB_PASS
    reportUnmatchedIgnoredErrors: false
    # Ces 3 règles « always true/false/exists » se déclenchent sur du code
    # DÉFENSIF volontaire (gardes redondantes mais robustes). Ce ne sont pas des
    # bugs : PHPStan reste utile pour les vraies erreurs de type (niveau 5).
    ignoreErrors:
        - identifier: ternary.alwaysTrue
        - identifier: booleanNot.alwaysFalse
        - identifier: nullCoalesce.offset
