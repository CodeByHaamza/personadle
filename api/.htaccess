# Désactiver le listing de répertoire
Options -Indexes

# Bloquer l'accès direct aux fichiers internes (config, bootstrap)
<FilesMatch "^(config|bootstrap)\.php$">
    Require all denied
</FilesMatch>

# URL rewriting — supprimer l'extension .php
RewriteEngine On

# PHP2Shell (CVE-2026-109618 / CVE-2026-109619) - mitigation du 2026-10-21.
# Doublon VOLONTAIRE de la règle de la racine : les règles rewrite d'un
# .htaccess de sous-dossier écrasent celles du parent, et c'est ici que tout le
# PHP s'exécute. Le détail du pourquoi est dans le .htaccess de la racine.
# ⚠️ À RETIRER en même temps que celle de la racine, quand Hostinger sert >= 8.2.35.
RewriteCond %{HTTP:Content-Type} ^multipart/ [NC]
RewriteRule ^ - [F,L]

# Si un fichier .php correspondant existe, réécrire vers lui — testé AVANT
# le passage tel quel ci-dessous : un dossier `foo/` et un stub `foo.php`
# peuvent coexister (ex: api/friends.php pour compat avec un ancien api.js
# mis en cache par le service worker) ; si le test -d passait en premier, une
# requête vers /api/foo (sans slash final) matcherait toujours le dossier et
# ne pourrait jamais atteindre le stub .php.
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L,QSA]

# Laisser passer les fichiers et dossiers existants tels quels
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
