Options -Indexes
RewriteEngine On

# Routes dans l'ordre du plus spécifique au plus général
# /api/admin/users/42/badges[/slug]     → user_badges.php
RewriteRule ^users/[0-9]+/badges        user_badges.php [L,QSA]

# /api/admin/users/42/wallpapers[/id]   → user_wallpapers.php
RewriteRule ^users/[0-9]+/wallpapers    user_wallpapers.php [L,QSA]

# /api/admin/users/42/titles[/id|/equip]→ user_titles.php
RewriteRule ^users/[0-9]+/titles        user_titles.php [L,QSA]

# /api/admin/users/42/expert[/mode]     → user_expert.php (déblocage manuel Mode Expert)
RewriteRule ^users/[0-9]+/expert        user_expert.php [L,QSA]

# /api/admin/users/42/stats             → user_stats.php
RewriteRule ^users/[0-9]+/stats$        user_stats.php [L,QSA]

# /api/admin/users/42/friends/5         → user_friends.php
RewriteRule ^users/[0-9]+/friends       user_friends.php [L,QSA]

# /api/admin/users/42                   → user.php
RewriteRule ^users/[0-9]+$              user.php [L,QSA]

# /api/admin/users                      → users.php
RewriteRule ^users$                     users.php [L,QSA]

# /api/admin/social-links               → social_links.php (liste)
RewriteRule ^social-links$              social_links.php [L,QSA]

# /api/admin/social-links/7             → social_links.php (détail/patch/delete)
RewriteRule ^social-links/[0-9]+$       social_links.php [L,QSA]

# /api/admin/event_codes                → event_codes.php (liste / créer)
RewriteRule ^event_codes$               event_codes.php [L,QSA]

# /api/admin/event_codes/MYCODE         → event_codes.php (patch / delete)
RewriteRule ^event_codes/(.+)$          event_codes.php [L,QSA]

# /api/admin/error_logs                 → error_logs.php (liste paginée)
RewriteRule ^error_logs$                error_logs.php [L,QSA]

# /api/admin/audit_log                  → audit_log.php (liste paginée)
RewriteRule ^audit_log$                 audit_log.php [L,QSA]

# /api/admin/deletion_requests[/id]     → deletion_requests.php (liste / hard-delete manuel)
RewriteRule ^deletion_requests          deletion_requests.php [L,QSA]

# /api/admin/rate_limits[/key]          → rate_limits.php (liste / purge manuelle)
RewriteRule ^rate_limits                rate_limits.php [L,QSA]
