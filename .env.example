# .env.example — Variables d'environnement pour Docker Compose
# Copier ce fichier en .env et adapter les valeurs.
# Le fichier .env est dans .gitignore — ne jamais committer le .env réel.

# ── MariaDB ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=personadle_db
MYSQL_USER=personadle_usr
MYSQL_PASSWORD=devpassword

# ── Ports exposés sur la machine hôte ────────────────────────────────────────
APP_PORT=8080       # Site → http://localhost:8080
PMA_PORT=8081       # PhpMyAdmin → http://localhost:8081
DB_EXPOSE_PORT=3307 # MariaDB direct (si besoin d'un client SQL externe)
