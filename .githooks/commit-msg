#!/usr/bin/env bash
# =============================================================
# commit-msg — Validation du format des messages de commit
#
# Format attendu (Conventional Commits) :
#   type(scope): description
#
# Types valides :
#   feat | fix | refactor | style | docs | test | chore | perf | revert
#
# Exemples valides :
#   feat(profile): add share modal redesign
#   fix(i18n): correct missing keys in fr.json
#   docs: update CLAUDE.md with mentor rules
#   chore: update git hooks
# =============================================================

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

RED='\033[0;31m'
NC='\033[0m'

# Ignorer les commits de merge, revert auto, squash, fixup
if echo "$COMMIT_MSG" | grep -qE '^(Merge|Revert|fixup!|squash!)'; then
  exit 0
fi

# Ignorer les lignes vides et les commentaires git
FIRST_LINE=$(echo "$COMMIT_MSG" | grep -v '^#' | head -1)
if [ -z "$FIRST_LINE" ]; then
  exit 0
fi

PATTERN='^(feat|fix|refactor|style|docs|test|chore|perf|revert)(\(.+\))?: .{3,}'

if ! echo "$FIRST_LINE" | grep -qE "$PATTERN"; then
  echo ""
  echo -e "${RED}✗ Invalid commit message format${NC}"
  echo ""
  echo "  Expected: type(scope): description"
  echo "  Got:      $FIRST_LINE"
  echo ""
  echo "  Valid types: feat | fix | refactor | style | docs | test | chore | perf | revert"
  echo ""
  echo "  Examples:"
  echo "    feat(profile): add share modal redesign"
  echo "    fix(i18n): correct missing keys in fr.json"
  echo "    docs: update CLAUDE.md with mentor rules"
  echo ""
  exit 1
fi

exit 0
