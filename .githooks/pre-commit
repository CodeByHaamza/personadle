#!/usr/bin/env bash
# =============================================================
# pre-commit — Vérifications avant chaque commit
#
# Checks effectués :
#   1. Cohérence des clés i18n (scripts/check-i18n.js)
#   2. Valeurs i18n identiques à l'anglais (avertissement, scripts/check-i18n-untranslated.js)
#   3. Présence de console.log dans les fichiers JS stagés
#   4. Tests unitaires (npm test)
#   5. Chiffres de doc (tests/tables/clés i18n) — auto-corrigés et re-stagés
# =============================================================

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo ""
echo "🔍  Pre-commit checks..."

# ─────────────────────────────────────────────────────────
# 1. Vérification i18n — cohérence des clés lang/
# ─────────────────────────────────────────────────────────
if command -v node &>/dev/null && [ -f "scripts/check-i18n.js" ]; then
  echo "  ▸ i18n key check..."
  if ! node scripts/check-i18n.js --silent 2>/dev/null; then
    echo -e "${RED}✗ i18n check failed — run 'npm run i18n:check' for details${NC}"
    exit 1
  fi
  echo -e "  ${GREEN}✓ i18n keys OK${NC}"
fi

# ─────────────────────────────────────────────────────────
# 2. Valeurs i18n identiques à l'anglais dans les fichiers lang/ stagés
#    (avertissement uniquement — ne bloque pas le commit, voir
#    scripts/check-i18n-untranslated.js pour le pourquoi)
# ─────────────────────────────────────────────────────────
STAGED_LANG=$(git diff --cached --name-only --diff-filter=ACM | grep '^lang/.*\.json$' || true)
if [ -n "$STAGED_LANG" ] && [ -f "scripts/check-i18n-untranslated.js" ]; then
  UNTRANSLATED_OUT=$(node scripts/check-i18n-untranslated.js --silent 2>/dev/null || true)
  if echo "$UNTRANSLATED_OUT" | grep -q "⚠️"; then
    echo -e "${YELLOW}⚠  candidats non traduits détectés — 'npm run i18n:check-untranslated' pour le détail (avertissement, commit non bloqué)${NC}"
  fi
fi

# ─────────────────────────────────────────────────────────
# 3. Détection de console.log oubliés dans les JS stagés
#    (avertissement uniquement — ne bloque pas le commit)
# ─────────────────────────────────────────────────────────
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACM | grep '\.js$' | grep -v 'node_modules' | grep -v 'check-i18n' || true)
if [ -n "$STAGED_JS" ]; then
  CONSOLE_HITS=$(echo "$STAGED_JS" | xargs grep -n 'console\.log' 2>/dev/null || true)
  if [ -n "$CONSOLE_HITS" ]; then
    echo -e "${YELLOW}⚠  console.log found in staged files (warning only — commit not blocked):${NC}"
    echo "$CONSOLE_HITS" | head -8 | sed 's/^/     /'
  fi
fi

# ─────────────────────────────────────────────────────────
# 4. Tests unitaires (Vitest)
# ─────────────────────────────────────────────────────────
if [ -f "package.json" ] && command -v npm &>/dev/null; then
  echo "  ▸ Running tests..."
  if ! npm test --silent 2>/dev/null; then
    echo -e "${RED}✗ Tests failed — fix before committing${NC}"
    exit 1
  fi
  echo -e "  ${GREEN}✓ Tests passed${NC}"
fi

# ─────────────────────────────────────────────────────────
# 5. Chiffres de doc (tests Vitest/PHPUnit/E2E, tables SQL, clés i18n)
#    Auto-corrigés dans CLAUDE.md/README.md/ROADMAP.md/etc. et re-stagés —
#    évite la dérive silencieuse qui a nécessité un audit complet (juillet 2026).
# ─────────────────────────────────────────────────────────
if [ -f "scripts/check-doc-numbers.js" ]; then
  echo "  ▸ Doc numbers check..."
  DOC_FIX_OUT=$(node scripts/check-doc-numbers.js --fix 2>&1) || true
  if echo "$DOC_FIX_OUT" | grep -q "corrigé"; then
    echo -e "${YELLOW}⚠  Chiffres de doc obsolètes, corrigés automatiquement et re-stagés :${NC}"
    echo "$DOC_FIX_OUT" | grep "^   -" | sed 's/^/    /'
    git add CLAUDE.md README.md ROADMAP.md CONTRIBUTING.md tests/README.md 2>/dev/null || true
  else
    echo -e "  ${GREEN}✓ Doc numbers OK${NC}"
  fi
fi

echo -e "${GREEN}✅  All pre-commit checks passed${NC}"
echo ""
